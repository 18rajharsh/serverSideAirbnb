<%- include('../partials/head')%>
</head>
<body class="min-h-screen bg-[#f5f1ea] text-slate-800">
    
    <%- include('../partials/nav')%>

    <main class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-8 sm:py-14">
        <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#E43D12]">Host dashboard</p>
                <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Your listed homes</h1>
                <p class="mt-3 text-slate-500">Manage the spaces you share with guests.</p>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            <% registeredHomes.forEach((homes) => { %>
                <div class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                    <img class="h-52 w-full object-cover transition duration-500 group-hover:scale-105" src="<%= homes.photourl %>" alt="<%= homes.houseName %>"/>
                    <div class="bg-white px-5 py-4">
                        <div class="mb-4">
                            <h2 class="font-semibold text-slate-900"><%= homes.houseName %></h2>
                            <p class="mt-1 text-sm text-slate-500"><%= homes.location %></p>
                        </div>
                        <div class="mb-5 flex items-end justify-between">
                            <h2 class="font-semibold text-slate-900">₹<%= homes.price %> <span class="text-xs font-normal text-slate-400">/ night</span></h2>
                            <h3 class="rounded-full bg-orange-50 px-2 py-1 text-xs font-medium text-[#E43D12]">★ <%= homes.rating %></h3>
                        </div>
                        <div class="flex gap-2">
                            <a href="/host/edit-homes/<%= homes._id %>?editing=true" class="flex-1 rounded-xl bg-[#E43D12] py-2.5 text-center text-sm font-semibold text-white transition hover:bg-[#c9350f]">
                        Edit
                        </a>
                        <form action="/host/delete-homes/<%= homes._id%>" method="post">
                            <button class="rounded-xl border border-red-200 px-4 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-50 cursor-pointer" type="submit">
                            Delete
                            </button>
                        </form>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
    </main>
</body>
</html>