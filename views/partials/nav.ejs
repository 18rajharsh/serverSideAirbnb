					<a class="<%= currentPage === 'favourites' ? 'bg-white text-[#E43D12] shadow-sm' : 'hover:bg-white hover:text-slate-900' %> rounded-lg px-3 py-2 transition" href="/favourites">Favourites</a>
					<a class="<%= currentPage === 'Bookings' ? 'bg-white text-[#E43D12] shadow-sm' : 'hover:bg-white hover:text-slate-900' %> rounded-lg px-3 py-2 transition" href="/bookings">Bookings</a>
				<% } else { %>
					<a class="<%= currentPage === 'host-homes' ? 'bg-white text-[#E43D12] shadow-sm' : 'hover:bg-white hover:text-slate-900' %> rounded-lg px-3 py-2 transition" href="/host/host-home-list">Host Homes</a>
					<a class="<%= currentPage === 'Add Home' ? 'bg-white text-[#E43D12] shadow-sm' : 'hover:bg-white hover:text-slate-900' %> rounded-lg px-3 py-2 transition" href="/host/add-home">Add Home</a>
