<% if (error.length> 0) { %>
    <div class="mb-6 w-full rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <div class="h-auto w-full">
            <strong class="font-semibold">Please review the following:</strong>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                <% error.forEach(err=> { %>
                    <li>
                        <%= err %>
                    </li>
                    <% })%>
            </ul>
        </div>
    </div>
<% } %>