<%- include('../partials/head')%>
</head>
<body class="min-h-screen bg-[#f5f1ea] text-slate-800">
    
    <%- include('../partials/nav')%>

    <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-8 sm:py-14">
        <div class="mb-10">
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#E43D12]">Stay details</p>
                <h1 class="text-4xl font-semibold tracking-tight text-slate-900">You are on the home details page</h1>
        </div>
        
        <div class="grid overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-900/10 lg:grid-cols-2">
            <div class="min-h-80 lg:min-h-full">
                <img class="h-full min-h-80 w-full object-cover" src="<%= home.photourl %>" alt="<%= home.houseName %>">
            </div>
            <div class="flex flex-col justify-center p-6 sm:p-10">
                <div class="border-b border-slate-200 pb-5">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-[#E43D12]">Description</p>
                    <p class="text-xl font-semibold text-slate-900"><%= home.houseName %></p>
                </div>
                <div class="border-b border-slate-200 py-5">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Location</p>
                    <p class="text-slate-800"><%= home.location %></p>
                </div>
                <div class="border-b border-slate-200 py-5">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Price</p>
                    <p class="text-xl font-semibold text-slate-900">₹<%= home.price %> <span class="text-sm font-normal text-slate-400">/ night</span></p>
                </div>
                <div class="py-5">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Rating</p>
                    <p class="font-medium text-[#E43D12]">★ <%= home.rating %></p>
                </div>
                <div>
                    <%- include('../partials/favourites') %>
                </div>
            </div>
        </div>
    </main>
</body>
</html>