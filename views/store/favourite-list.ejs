

<%- include('../partials/head')%>
</head>
<body class="min-h-screen bg-[#f5f1ea] text-slate-800">
    
    <%- include('../partials/nav')%>

    <main class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-8 sm:py-14">
        <div class="mb-10 max-w-2xl">
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#E43D12]">Saved for later</p>
                <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Your favourites</h1>
                <p class="mt-3 text-slate-500">Keep the places you love close at hand.</p>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            <% favouriteHomes.forEach((homes) => { %>
                <div class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                    <img class="h-52 w-full object-cover transition duration-500 group-hover:scale-105" src="<%= homes.photourl %>" alt="<%= homes.houseName %>"/>
                    <div class="bg-white px-5 py-4">
                        <div class="mb-4">
                            <h2 class="font-semibold text-slate-900"><%= homes.houseName %></h2>
                            <p class="mt-1 text-sm text-slate-500"><%= homes.location %></p>
                        </div>
                        <div class="mb-5 flex items-end justify-between">
                            <h2 class="font-semibold text-slate-900">₹<%= homes.price %> <span class="text-xs font-normal text-slate-400">/ night</span></h2>
                            <h3 class="rounded-full bg-orange-50 px-2 py-1 text-xs font-medium text-[#E43D12]">★ <%= homes.rating %></h3>
                        </div>
                        <!-- <button class="bg-[#E43D12] text-white mt-2 py-2 px-4 rounded-lg hover:bg-[#c22a0f] transition-colors duration-300 hover:cursor-pointer">
                        Book Now
                        </button> -->
                        <form action="/favourites/delete/<%= homes._id%>" method="post">
                            <button class="mt-2 w-full rounded-xl border border-red-200 py-2.5 text-sm font-semibold text-red-600 transition hover:bg-red-50 cursor-pointer" type="submit">
                            Remove
                            </button>
                        </form>
                    </div>
                </div>
                <% }) %>
        </div>
    </main>
</body>
</html>